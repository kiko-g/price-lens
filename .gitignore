# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts output
scripts/*.csv
scripts/*-failed-ids.txt

# run logs
/logs

# database dumps
production_dump.sql
production_data.sql
supabase/schema.sql
supabase/data.sql
*.dump

# docs
docs/*
*.local.*

# Android TWA (generated project, signing key, Play artifacts)
mobile/android-twa/android/
mobile/android-twa/app/
mobile/android-twa/gradle/
mobile/android-twa/build.gradle
mobile/android-twa/settings.gradle
mobile/android-twa/gradle.properties
mobile/android-twa/gradlew
mobile/android-twa/gradlew.bat
mobile/android-twa/manifest-checksum.txt
mobile/android-twa/store_icon.png
mobile/android-twa/*.keystore
mobile/android-twa/*.jks
mobile/android-twa/.keystore-pass
mobile/android-twa/app-release-signed.aab
mobile/android-twa/app-release-signed.apk
mobile/android-twa/app-release-bundle.aab
mobile/android-twa/app-release-unsigned-aligned.apk
mobile/android-twa/node_modules/

# local archive
archive
